# Copy values into your deployment environment; never commit a real .env file.
# Production requires an explicit, non-wildcard host allowlist.
CROP_ADVISOR_ENV=development
CROP_ADVISOR_ALLOWED_HOSTS=localhost,127.0.0.1
CROP_ADVISOR_MAX_REQUEST_BYTES=65536
CROP_ADVISOR_METRICS_ENABLED=true

# These defaults are appropriate for a local checkout after training.
CROP_ADVISOR_MODEL_PATH=artifacts/maharashtra_crop_suitability_v1/model.joblib
CROP_ADVISOR_MODEL_SHA256=
CROP_ADVISOR_CONTRACT_PATH=data/contracts/maharashtra_crop_recommendation.v1.json
